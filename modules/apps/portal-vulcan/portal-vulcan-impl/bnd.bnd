Bundle-Name: Liferay Portal Vulcan Implementation
Bundle-SymbolicName: com.liferay.portal.vulcan.impl
Bundle-Version: 5.0.107
Import-Package:\
	!com.google.errorprone.annotations.*,\
	!com.google.gson.*,\
	\
	!com.sun.jdi.*,\
	!com.sun.tools.*,\
	\
	!com.thoughtworks.paranamer.*,\
	\
	!javafx.beans.*,\
	\
	!javax.money.*,\
	\
	!lombok,\
	\
	!org.checkerframework.checker.nullness.qual.*,\
	\
	!org.joda.time.*,\
	\
	!org.jsoup.*,\
	\
	*
Require-Capability:\
	osgi.extender;\
		filter := "(&(osgi.extender=osgi.configurator)(version>=1.0)(!(version>=2.0)))"
-fixupmessages: "^Classes found in the wrong directory: \\\\{META-INF/versions/9/";is:=warning
-includeresource: OSGI-INF/configurator=configurator