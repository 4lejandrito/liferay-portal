<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.1.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_1_0.dtd">

<service-builder auto-import-default-references="false" auto-namespace-tables="false" package-path="com.liferay.frontend.editor.configuration">
	<namespace>ReadingTime</namespace>
	<entity local-service="true" name="EditorConfigurationEntry" remote-service="false" trash-enabled="false" uuid="true">

		<!-- PK fields -->

		<column name="editorConfigurationEntryId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="createDate" type="Date" />
		<column name="modifiedDate" type="Date" />

		<!-- Other fields -->

		<column name="portletName" type="String" />
		<column name="editorName" type="String" />
		<column name="editorConfigKey" type="String" />
		<column name="configuration" type="String" />
		<column name="enabled" type="boolean" />

		<!-- Order -->

		<order by="desc">
			<order-column name="createDate" />
		</order>

		<!-- Finder methods -->

		<finder name="P_E_E" return-type="EditorConfigurationEntry" unique="true">
			<finder-column name="portletName" />
			<finder-column name="editorName" />
			<finder-column name="editorConfigKey" />
		</finder>
	</entity>
</service-builder>