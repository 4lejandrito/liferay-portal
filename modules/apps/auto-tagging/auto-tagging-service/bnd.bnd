Bundle-Name: auto-tagging-service
Bundle-SymbolicName: com.liferay.demo.autotagging.service
Bundle-Version: 1.0.0

Import-Package: \
	!com.beust.jcommander.*,\
	!com.barchart.udt.*,\
	!com.carrotsearch.hppc.*,\
	!com.conversantmedia.*,\
	!com.fasterxml.jackson.*,\
	!com.google.common.geometry.*,\
	!com.lmax.*,\
	!com.sun.*,\
	!com.tdunning.math.stats.*,\
	!com.vividsolutions.*,\
	!gnu.io.*,\
	!joptsimple.*,\
	!io.netty.*,\
	!org.apache.avalon.*,\
	!org.apache.commons.*,\
	!org.apache.log.*,\
	!org.apache.logging.*,\
	!org.apache.lucene.*,\
	!org.apache.kafka.*,\
	!org.apache.tomcat.*,\
	!org.apache.xml.resolver.*,\
	!org.elasticsearch.*,\
	!org.fusesource.*,\
	!org.HdrHistogram.*,\
	!org.jctools.*,\
	!org.joda.*,\
	!org.locationtech.*,\
	!org.noggit,\
	!org.zeromq,\
	!org.jboss.*,\
	!com.github.mustachejava.*,\
	!sun.*,\
	*

-fixupmessages  "Classes found in the wrong directory"; \
    is:=warning

